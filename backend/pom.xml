<?xml version="1.0" encoding="UTF-8"?>
<!--
  pom.xml  ==  package.json of the Java world (Maven build tool).

  - <parent>         : inherits Spring Boot's curated dependency versions (like a "peerDependencies" BOM).
  - <dependencies>   : libraries we use. No versions needed for Spring-managed libs - the parent pins them.
  - <build><plugins> : build tooling (like "scripts" + webpack/esbuild config).

  Common commands (run inside /backend, or via Docker - see docs/03-docker-and-devops.md):
    mvn spring-boot:run     -> npm start
    mvn test                -> npm test
    mvn clean package       -> npm run build  (produces target/*.jar)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <!-- groupId + artifactId == the npm package name. -->
    <groupId>com.walkthrough</groupId>
    <artifactId>walkthrough-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>walkthrough-api</name>
    <description>Java 21 + Spring Boot learning project - REST API</description>

    <properties>
        <java.version>21</java.version>
        <springdoc.version>2.8.9</springdoc.version>
    </properties>

    <dependencies>
        <!-- REST controllers + embedded Tomcat server (like express). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA/Hibernate ORM (like TypeORM / Prisma) + Spring Data repositories. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Bean Validation: @NotBlank, @Size ... (like class-validator in NestJS). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Health/metrics endpoints: /actuator/health is used by Docker healthcheck. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Flyway: versioned SQL migrations (like knex/prisma migrate). Runs on startup. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC driver (like the "pg" npm package). Only needed at runtime. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- OpenAPI docs + Swagger UI at /swagger-ui.html (like @nestjs/swagger). -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Testing: JUnit 5 + Mockito + AssertJ + MockMvc (like jest + supertest). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Packages the app as a single executable "fat jar": java -jar app.jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
